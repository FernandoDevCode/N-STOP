<resources>
    <!-- Settings › Library & Storage: "Export for Stash on the web" (the web player's library file). -->
    <string name="web_library_export_title">Stash on the web</string>
    <string name="web_library_export_subtitle">Take your likes, your playlists and what you played lately to Stash on the web. Then, in the web player: Settings › Your library › Import from the Stash app.</string>
    <string name="web_library_export_button">Export for Stash on the web</string>
    <string name="web_library_export_working_title">Exporting your library</string>
    <string name="web_library_export_done_title">Ready for the web</string>
    <!-- %1$s likes, %2$s playlists, %3$s plays: the three counts below. -->
    <string name="web_library_export_done_body">Saved %1$s, %2$s and %3$s. Open Stash on the web and import this file in Settings › Your library.</string>
    <plurals name="web_library_export_likes">
        <item quantity="one">%d like</item>
        <item quantity="other">%d likes</item>
    </plurals>
    <plurals name="web_library_export_playlists">
        <item quantity="one">%d playlist</item>
        <item quantity="other">%d playlists</item>
    </plurals>
    <plurals name="web_library_export_plays">
        <item quantity="one">%d play</item>
        <item quantity="other">%d plays</item>
    </plurals>
    <string name="web_library_export_failed_title">Couldn’t export</string>
    <string name="web_library_export_failed_body">The file couldn’t be written. Try again, or pick another place to save it.</string>
    <string name="web_library_export_ok">OK</string>
    <string name="web_library_import_button">Import from Stash on the web</string>
    <!-- %1$s: the browser's name ("Chrome on Windows"). -->
    <string name="web_library_sent_title">Sent</string>
    <!-- %1$s the browser, %2$s likes, %3$s playlists, %4$s plays. -->
    <string name="web_library_sent_body">Sent %2$s, %3$s and %4$s to %1$s. It asks there before adding anything.</string>
