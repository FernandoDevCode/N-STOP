        <item quantity="one">%d música curtida</item>
        <item quantity="other">%d músicas curtidas</item>
    </plurals>
    <plurals name="web_library_export_playlists">
        <item quantity="one">%d playlist</item>
        <item quantity="other">%d playlists</item>
    </plurals>
    <plurals name="web_library_export_plays">
        <item quantity="one">%d reprodução</item>
        <item quantity="other">%d reproduções</item>
    </plurals>
