    <string name="web_library_export_title">Stash na web</string>
    <string name="web_library_export_subtitle">Leve suas músicas curtidas, playlists e reproduções recentes para o Stash na web. Depois, no player web, acesse Configurações › Sua biblioteca › Importar do aplicativo Stash.</string>
    <string name="web_library_export_button">Exportar para o Stash na web</string>
    <string name="web_library_export_working_title">Exportando sua biblioteca</string>
    <string name="web_library_export_done_title">Pronto para usar na web</string>
    <string name="web_library_export_done_body">Foram salvos %1$s, %2$s e %3$s. Abra o Stash na web e importe este arquivo em Configurações › Sua biblioteca.</string>
