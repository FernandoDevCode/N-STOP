---
/**
 * The 8-digit code box. The email rides along in a hidden field the Worker fills in (data-value="email"),
 * so the code is checked against the address it was sent to. So does where to go afterwards (data-value="next":
 * empty, or /player when signing in started there; the Worker checks it again, worker/player.js playerReturn).
 * The code only works in the browser that asked for it (the stash_signin cookie, worker/session.js). The pattern
 * takes the 8 digits with a space or hyphen between any two; the Worker takes any spacing (worker/codes.js cleanCode).
 */
---

<form method="post" action="/access/verify" class="code-form">
  <input type="hidden" name="email" value="" data-value="email" />
  <input type="hidden" name="next" value="" data-value="next" />
  <label class="label" for="code">Your 8-digit code</label>
  <div class="row">
    <input
      class="input input-code"
      id="code"
      name="code"
      type="text"
      inputmode="numeric"
      autocomplete="one-time-code"
      minlength="8"
      maxlength="11"
      pattern="\s*(\d[\s\-]?){7}\d\s*"
      title="The 8 digits from the email"
      required
      autofocus
      spellcheck="false"
    />
    <button type="submit" class="button button-primary">Sign in</button>
  </div>
</form>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .row .input {
    flex: 1 1 200px;
    min-width: 0;
  }

  .row .button {
    flex: 0 0 auto;
  }

  @media (max-width: 420px) {
    .row .button {
      flex: 1 1 100%;
    }
  }
</style>
